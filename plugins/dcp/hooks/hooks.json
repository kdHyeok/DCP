{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"require(require('node:path').join(process.env.PLUGIN_ROOT||process.env.CLAUDE_PLUGIN_ROOT,'hooks/understanding.cjs'))\"",
            "timeout": 10,
            "statusMessage": "DCP 이해도 확인 지침 로드"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"require(require('node:path').join(process.env.PLUGIN_ROOT||process.env.CLAUDE_PLUGIN_ROOT,'hooks/understanding.cjs'))\"",
            "timeout": 10,
            "statusMessage": "DCP 이해도 확인 절차 유지"
          }
        ]
      }
    ]
  }
}
